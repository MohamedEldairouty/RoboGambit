<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robogambit_ik</name>
  <version>0.1.0</version>
  <description>
    Inverse kinematics translator for RoboGambit. Subscribes to chess move
    strings from the GUI, looks up calibrated arm positions, and publishes
    servo angle commands to the Arduino serial bridge.
  </description>
  <maintainer email="team@robogambit.local">RoboGambit Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
